# Clé API Anthropic (console.anthropic.com) — jamais commitée, à ajouter dans
# les variables d'environnement du projet Vercel (Settings > Environment Variables).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL du webhook Apps Script (voir google-apps-script/Code.gs + README) —
# optionnel : sans elle, les leads sont juste loggés dans Vercel, pas dans une feuille.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
